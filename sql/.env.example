# UNICORN Database Connection Settings
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Database Server (IP or hostname)
UNICORN_SERVER=localhost

# Database Name (verify with SQL Server)
UNICORN_DATABASE=UNICORN

# Username for SQL Server authentication
UNICORN_USER=sa

# Password for SQL Server authentication
# Empty string "" for Windows Authentication
UNICORN_PASSWORD=

# Optional: Custom port if not using default 1433
# UNICORN_PORT=1433
