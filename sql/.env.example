# UNICORN Database Connection Settings
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
#
# Or run pycorn-setup: it asks for these values and writes a per-user file.
#
# PyCORNDatabase() reads the first of: the file named by PYCORN_ENV_FILE, sql/.env or
# .env in the current folder, sql/.env in the PyCORN source folder, the per-user file
# pycorn-setup writes. UNICORN_* variables set in the environment override the same keys
# in the file.
# Values may be quoted ("..." or '...'); inside quotes, '#' is kept. Unquoted, " #"
# starts a comment.

# Database Server (IP or hostname)
UNICORN_SERVER=

# Database Name (empty: the login's default database)
UNICORN_DATABASE=

# SQL Server login (SQL Server authentication; Windows authentication is not supported).
# Use a read-only login, e.g. one made with sql/scripts/create-user.sql
UNICORN_USER=
UNICORN_PASSWORD=

# Optional: TCP port of the SQL Server service. Leave empty for the default (1433).
# Set it when several SQL Server services run on the same host, each on its own port.
UNICORN_PORT=

# Optional: search several databases on this server: a comma list, or * for every
# UNICORN database the login can open. Adds to UNICORN_DATABASE.
# UNICORN_DATABASES=

# Optional: more servers ("sources"). Each alias is a short name you choose (letters,
# digits, _); "default" is the connection above. Searches run in this order and print
# only the alias, never server or database names. Without UNICORN_SOURCES, only the
# connection above is used.
# UNICORN_SOURCES=default,lab2
# UNICORN_LAB2_SERVER=
# UNICORN_LAB2_PORT=
# UNICORN_LAB2_DATABASES=
# UNICORN_LAB2_USER=
# UNICORN_LAB2_PASSWORD=
